# pnpm dev generates .env; scripts/start.sh generates a separate .env.production.
# Never commit actual credentials. Keep PC_SECRET_KEY together with database backups.
POSTGRES_PASSWORD=replace-with-random-hex-password
PC_ADMIN_TOKEN=replace-with-at-least-32-random-characters
PC_SECRET_KEY=replace-with-exactly-64-random-hex-characters

# Development: API and web run separately with Vite proxying /api and /install.sh.
DATABASE_URL=postgres://personal_cloud:replace-with-random-hex-password@127.0.0.1:55438/personal_cloud
PC_BIND=127.0.0.1:4311
PC_WEB_ORIGIN=http://127.0.0.1:4310

# Production Compose: PostgreSQL/API remain private; only the web port is published.
# Use an HTTPS origin behind your reverse proxy for remote agents and GitHub webhooks.
PC_PUBLIC_URL=http://127.0.0.1:4310
PC_PORT=4310
PC_HOST_BIND=127.0.0.1

# Published API/web image tag. Set an exact vX.Y.Z release to pin upgrades.
PC_VERSION=latest
# To build locally, invoke PC_BUILD_FROM_SOURCE=1 bash scripts/start.sh.
